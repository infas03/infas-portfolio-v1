---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
---

<header data-nav class="site-nav fixed inset-x-0 top-0 z-50">
  <div class="progress" data-progress aria-hidden="true"></div>
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6">
    <a href="#top" class="group flex items-center gap-2.5" aria-label={`${site.name}, back to top`}>
      <span class="grid size-8 place-items-center rounded-lg bg-amber font-display text-lg font-bold leading-none text-ink-950 transition-transform duration-300 group-hover:-rotate-6">
        i
      </span>
      <span class="font-display text-lg font-semibold tracking-tight">infas<span class="text-amber">.</span></span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} data-nav-link class="nav-link">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="#contact" class="btn btn-ghost hidden !h-10 !px-5 !text-[0.82rem] sm:inline-flex">Let's talk</a>
      <button
        type="button"
        data-menu-toggle
        class="grid size-10 place-items-center rounded-full border border-white/15 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
      >
        <span class="menu-open"><Icon name="lucide:menu" size={18} /></span>
        <span class="menu-close"><Icon name="lucide:x" size={18} /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-menu class="mobile-menu lg:hidden" hidden>
    <nav class="wrap flex flex-col pb-6 pt-2" aria-label="Mobile">
      {nav.map((item) => (
        <a href={item.href} data-menu-link class="border-b border-line py-4 font-display text-xl">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-nav {
    border-bottom: 1px solid transparent;
    transition: background-color 0.35s ease, border-color 0.35s ease, backdrop-filter 0.35s ease;
  }
  .site-nav[data-scrolled],
  .site-nav[data-open] {
    background: rgb(8 9 11 / 0.78);
    border-bottom-color: var(--color-line);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .progress {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--color-amber);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }
  .nav-link {
    position: relative;
    padding-block: 0.4rem;
    font-size: 0.86rem;
    color: var(--color-muted);
    transition: color 0.25s ease;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 1.5px;
    background: var(--color-amber);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .nav-link:hover,
  .nav-link[aria-current="true"] { color: var(--color-fg); }
  .nav-link:hover::after,
  .nav-link[aria-current="true"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .menu-close { display: none; }
  .site-nav[data-open] .menu-open { display: none; }
  .site-nav[data-open] .menu-close { display: block; }
  .mobile-menu { background: rgb(8 9 11 / 0.92); }
</style>
