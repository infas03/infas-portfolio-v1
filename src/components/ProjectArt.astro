---
// Abstract line illustrations used as project covers (swap for real screenshots when you have them).
interface Props { kind: string }
const { kind } = Astro.props;

const booked = [3, 9, 10, 16, 19, 24];
const cells = Array.from({ length: 28 }, (_, i) => ({ x: 57 + (i % 7) * 42, y: 46 + Math.floor(i / 7) * 30, on: booked.includes(i), live: i === 16 }));
const bars = [38, 56, 44, 70, 62, 88, 76, 104];
const nodes = [
  [200, 100, 13], [112, 58, 8], [96, 132, 7], [150, 160, 6], [286, 52, 8], [310, 126, 9], [252, 164, 6], [176, 34, 5],
];
---

<svg viewBox="0 0 400 200" class="art" role="img" aria-label="Abstract project illustration" preserveAspectRatio="xMidYMid slice">
  {kind === 'venue' && (
    <g>
      <text x="57" y="32" class="t">MON</text><text x="183" y="32" class="t">THU</text><text x="309" y="32" class="t">SUN</text>
      {cells.map((c) => (
        <rect x={c.x} y={c.y} width="34" height="22" rx="5" class:list={[c.on ? 'fa' : 's', c.live && 'pulse']} />
      ))}
    </g>
  )}

  {kind === 'platform' && (
    <g>
      <rect x="52" y="34" width="232" height="136" rx="10" class="s" />
      <line x1="52" y1="56" x2="284" y2="56" class="s" />
      <circle cx="66" cy="45" r="3" class="fa" /><circle cx="77" cy="45" r="3" class="f" /><circle cx="88" cy="45" r="3" class="f" />
      <rect x="68" y="72" width="60" height="82" rx="6" class="s" />
      <rect x="142" y="72" width="126" height="10" rx="5" class="f" />
      <rect x="142" y="92" width="92" height="8" rx="4" class="f" />
      <rect x="142" y="110" width="110" height="8" rx="4" class="f" />
      <rect x="142" y="134" width="56" height="20" rx="10" class="fa" />
      <rect x="262" y="58" width="82" height="130" rx="14" class="phone" />
      <rect x="290" y="66" width="26" height="5" rx="2.5" class="f" />
      <rect x="274" y="84" width="46" height="16" rx="8" class="f" />
      <rect x="286" y="108" width="46" height="16" rx="8" class="fa pulse" />
      <rect x="274" y="132" width="36" height="16" rx="8" class="f" />
      <path d="M303 160 l3 7 7 3 -7 3 -3 7 -3 -7 -7 -3 7 -3z" class="fa" />
    </g>
  )}

  {kind === 'payroll' && (
    <g>
      <line x1="56" y1="166" x2="344" y2="166" class="s" />
      {bars.map((h, i) => (
        <rect x={64 + i * 35} y={166 - h} width="20" height={h} rx="4" class={i === bars.length - 1 ? 'fa' : 'f'} />
      ))}
      <polyline points="74,118 109,100 144,112 179,84 214,92 249,64 284,74 319,46" class="la draw" />
      <circle cx="319" cy="46" r="5" class="fa" /><circle cx="319" cy="46" r="5" class="fa ring" />
    </g>
  )}

  {kind === 'ble' && (
    <g>
      <path d="M36 104 H132 l10 -34 l16 72 l14 -58 l10 30 l8 -10 H252" class="la draw" />
      <g transform="rotate(-32 306 100)">
        <rect x="276" y="84" width="60" height="32" rx="16" class="s" />
        <path d="M306 84 h14 a16 16 0 0 1 0 32 h-14z" class="fa" />
      </g>
      <path d="M262 62 a54 54 0 0 1 88 0" class="s wave" /><path d="M250 46 a74 74 0 0 1 112 0" class="s wave w2" />
    </g>
  )}

  {kind === 'social' && (
    <g>
      {nodes.slice(1).map(([x, y]) => <line x1="200" y1="100" x2={x} y2={y} class="s" />)}
      <line x1="112" y1="58" x2="176" y2="34" class="s" /><line x1="286" y1="52" x2="310" y2="126" class="s" /><line x1="96" y1="132" x2="150" y2="160" class="s" />
      {nodes.map(([x, y, r], i) => <circle cx={x} cy={y} r={r} class={i === 0 ? 'fa' : i % 3 === 1 ? 'node-a' : 'node'} />)}
      <circle cx="200" cy="100" r="13" class="fa ring" />
    </g>
  )}
</svg>

<style>
  .art { width: 100%; height: 100%; display: block; }
  .s { fill: none; stroke: rgb(255 255 255 / 0.16); stroke-width: 1.4; }
  .f { fill: rgb(255 255 255 / 0.1); }
  .fa { fill: var(--color-amber); }
  .la { fill: none; stroke: var(--color-amber); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .t { fill: rgb(255 255 255 / 0.35); font: 500 9px var(--font-mono); letter-spacing: 0.14em; }
  .phone { fill: var(--color-ink-800); stroke: rgb(255 255 255 / 0.22); stroke-width: 1.4; }
  .node { fill: var(--color-ink-800); stroke: rgb(255 255 255 / 0.3); stroke-width: 1.4; }
  .node-a { fill: var(--color-ink-800); stroke: var(--color-amber); stroke-width: 1.6; }

  .pulse { animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.35; } }

  .ring { transform-box: fill-box; transform-origin: center; animation: ring 2.4s ease-out infinite; }
  @keyframes ring {
    from { transform: scale(1); opacity: 0.6; }
    to { transform: scale(2.8); opacity: 0; }
  }

  .draw { stroke-dasharray: 520; stroke-dashoffset: 0; }
  :global(.project:hover) .draw { animation: draw 1.4s ease-out; }
  @keyframes draw { from { stroke-dashoffset: 520; } to { stroke-dashoffset: 0; } }

  .wave { animation: pulse 2.4s ease-in-out infinite; }
  .w2 { animation-delay: 0.5s; }
</style>
